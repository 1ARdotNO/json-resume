{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "automerge": true,
  "platformAutomerge": false,
  "internalChecksFilter": "strict",
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 4,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Automerge GitHub Actions updates once CI passes.",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "Automerge non-major npm updates once CI passes.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Major npm updates: still automerged, but held longer so the render/schema tests catch breakage first.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    }
  ]
}
